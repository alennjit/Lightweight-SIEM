# Copy to .env and fill in real values. Never commit the real .env file.

LOG_LEVEL=INFO

# Claude API (risk narrative generation — see app/detection/claude_analyzer.py)
ANTHROPIC_API_KEY=

# Fernet key encrypting OAuth tokens at rest — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Accounts & sessions (non-secret; defaults are fine for local dev)
# SESSION_COOKIE_SECURE=true      # browsers allow Secure cookies on http://localhost
# SESSION_TTL_HOURS=168
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email provider OAuth (Gmail) — from Google Cloud Console, see CONTRIBUTING.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback

# Email provider OAuth (Microsoft Graph / Outlook) — not yet wired up
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Alerting — not yet wired up
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Billing — not yet wired up
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Threat intel / URL reputation source — provider TBD, see docs/ARCHITECTURE.md
URL_REPUTATION_API_KEY=
